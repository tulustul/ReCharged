# QA DoD-1, gamepad only (virtual pad 1: D-pad, A, B, LB/RB, Start, RT): every main-menu screen,
# Settings (every tab, speed unit, a graphics preset change, an audio volume change, a rebind with a
# conflict, Reset bindings), Championship race 1 (pause →
# Settings in the pause menu → graphics preset live → resume → finish → results → standings → quit
# cup), Time Trial (finish → results → Retry with the ghost → pause → quit), the Quit dialog.
# Quick Race and Versus are covered by tools/scripts/gamepad_only.script.
#   rm -rf target/qa/data/pad_modes && cargo run -p recharged -- --user-data-dir target/qa/data/pad_modes \
#     --window 1600x900 --input-script tools/scripts/qa/pad_modes.script --exit-after 900
# Screenshots: <user-data-dir>/screenshots/padm_*.png. Fresh profile, default settings.

wait ui
wait screen title
0.3 nav gamepad confirm          # Title: any button
1.5 shot padm_01_main

# Garage (5th entry)
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad confirm
2.0 shot padm_02_garage
0.3 nav gamepad right
0.3 nav gamepad right
0.3 nav gamepad right            # Torque: locked
0.6 shot padm_03_garage_locked
0.3 nav gamepad back             # B

# Records (6th entry), every tab
1.5 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad confirm
2.0 shot padm_04_records_tracks
0.3 nav gamepad nextTab
0.6 shot padm_05_records_trophies
0.3 nav gamepad nextTab
0.6 shot padm_06_records_batteries
0.3 nav gamepad nextTab
0.6 shot padm_07_records_stats
0.3 nav gamepad back

# How to play (7th entry), every tab
1.5 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad confirm
2.0 shot padm_08_howto_controls
0.3 nav gamepad nextTab
0.6 shot padm_09_howto_charge
0.3 nav gamepad nextTab
0.6 shot padm_10_howto_items
0.3 nav gamepad nextTab
0.6 shot padm_11_howto_recovery
0.3 nav gamepad back

# Credits (9th entry: up ×2 wraps through Quit)
1.5 nav gamepad up
0.3 nav gamepad up
0.3 nav gamepad confirm
4.0 shot padm_12_credits
0.3 nav gamepad back

# Settings (8th entry: up ×3)
1.5 nav gamepad up
0.3 nav gamepad up
0.3 nav gamepad up
0.3 nav gamepad confirm
2.0 nav gamepad right            # Gameplay: speed unit → mph
0.6 shot padm_13_settings_gameplay
0.3 nav gamepad nextTab          # Graphics
0.6 nav gamepad left             # preset High → Medium
0.3 nav gamepad left             # → Low
0.6 shot padm_14_settings_graphics_low
0.3 nav gamepad nextTab          # Audio
0.6 nav gamepad down             # Music
0.3 nav gamepad left             # 70 → 65 %
0.3 nav gamepad left             # → 60 %
0.6 shot padm_15_settings_audio
0.3 nav gamepad nextTab          # Controls (scheme: Gamepad, the device in use)
0.6 nav gamepad down             # Throttle
0.3 nav gamepad down             # Brake
0.3 nav gamepad down             # Steer left
0.3 nav gamepad down             # Steer right
0.3 nav gamepad down             # Drift
0.3 nav gamepad down             # Use item
0.6 shot padm_16_settings_controls
0.3 nav gamepad confirm          # capture
0.8 shot padm_17_rebind_capture
0.3 tap gamepad camera           # View → Use item (conflicts with Camera)
1.0 shot padm_18_rebind_conflict
0.3 nav gamepad down             # Boost
0.3 nav gamepad down             # Look back
0.3 nav gamepad down             # Reset
0.3 nav gamepad down             # Camera
0.3 nav gamepad down             # Pause
0.3 nav gamepad down             # Reset bindings
0.3 nav gamepad confirm
1.0 shot padm_18b_bindings_reset
0.3 nav gamepad nextTab          # Accessibility
0.6 nav gamepad down             # Colour-blind markers
0.3 nav gamepad down             # Steering assist
0.3 nav gamepad confirm          # on
0.6 shot padm_19_settings_access
0.3 nav gamepad back

# Championship: Rookie Cup, race 1 (Sofa Circuit)
1.5 nav gamepad confirm
2.0 shot padm_20_cup_select
0.3 nav gamepad right            # Pro Cup (locked)
0.6 shot padm_21_cup_locked
0.3 nav gamepad confirm          # locked: error cue, stays
0.6 nav gamepad left
0.3 nav gamepad confirm          # Rookie Cup → car select
2.0 shot padm_22_cup_car_select
0.3 nav gamepad confirm          # race
wait countdown
1.0 shot padm_23_cup_countdown
wait racing
hold gamepad throttle 1
@300 shot padm_24_cup_racing_low
@420 tap gamepad item            # A again after the reset
@600 release gamepad
0.2 tap gamepad pause            # Start
wait paused
1.0 shot padm_25_cup_pause
0.3 nav gamepad down             # Restart
0.3 nav gamepad down             # How to play
0.3 nav gamepad confirm
1.0 shot padm_26_pause_howto
0.3 nav gamepad back
0.8 nav gamepad down             # Settings
0.3 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad confirm
1.5 nav gamepad nextTab          # Graphics
0.6 nav gamepad right            # Low → Medium
0.3 nav gamepad right            # → High
0.6 shot padm_27_pause_settings
0.3 nav gamepad back             # pause menu
0.8 nav gamepad back             # B in the pause menu: resume
wait running
0.2 hold gamepad throttle 1
2.0 shot padm_28_cup_racing_high
wait finished
release gamepad
3.5 shot padm_29_cup_results
0.3 nav gamepad confirm          # Continue → standings
2.0 shot padm_30_cup_standings
0.3 nav gamepad down             # Quit cup
0.3 nav gamepad confirm          # dialog: Cancel focused
0.6 shot padm_31_quit_cup_dialog
0.3 nav gamepad left             # Quit cup
0.3 nav gamepad confirm
wait menu
2.5 shot padm_32_after_quit_cup
0.3 nav gamepad back             # cup select → main

# Time Trial on Backyard Bash (3 laps, no rivals)
1.5 nav gamepad down
0.3 nav gamepad down
0.3 nav gamepad confirm
2.0 nav gamepad up
0.3 nav gamepad left
0.3 nav gamepad left             # Toy Town
0.3 nav gamepad right
0.3 nav gamepad right            # Backyard Bash
0.6 shot padm_33_tt_track_select
0.3 nav gamepad confirm          # select it: the focus moves to Choose car
0.3 nav gamepad confirm          # → car select
2.0 nav gamepad confirm          # race
wait racing
hold gamepad throttle 1
@600 shot padm_34_tt_racing
wait finished
release gamepad
3.5 shot padm_35_tt_results
0.3 nav gamepad confirm          # Retry (instant, races the ghost)
wait countdown
1.0 shot padm_36_tt_retry_countdown
wait racing
hold gamepad throttle 1
@240 shot padm_37_tt_retry_ghost
@300 release gamepad
0.2 tap gamepad pause            # Start
wait paused
0.3 nav gamepad down             # Restart
0.3 nav gamepad down             # How to play
0.3 nav gamepad down             # Settings
0.3 nav gamepad down             # Quit race
0.3 nav gamepad confirm
0.4 nav gamepad left
0.3 nav gamepad confirm
wait menu
2.0 shot padm_38_after_tt_quit         # quitting a race returns to the Car select
0.3 nav gamepad back               # → Track select
1.5 nav gamepad back               # → main menu
1.5 shot padm_38b_main

# Quit dialog: open, cancel
0.3 nav gamepad up               # Quit
0.3 nav gamepad confirm
0.8 shot padm_39_quit_dialog
0.3 nav gamepad confirm          # Cancel (focused)
1.0 shot padm_40_main_end
1.0 exit
