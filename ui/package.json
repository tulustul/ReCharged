{
  "name": "recharged-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bevy-react build",
    "build:prod": "bevy-react build --prod",
    "watch": "bevy-react build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "bevy:generate": "cargo run --manifest-path ../Cargo.toml -p rc_ui --example export_bindings -- src/bevy.ts"
  },
  "dependencies": {
    "bevy-react": "^0.8.1",
    "react": "19.2.7",
    "react-reconciler": "0.33.0"
  },
  "devDependencies": {
    "@swc/core": "1.10.1",
    "@types/react": "19.2.17",
    "esbuild": "0.24.0",
    "react-refresh": "0.18.0",
    "typescript": "5.6.3"
  }
}
