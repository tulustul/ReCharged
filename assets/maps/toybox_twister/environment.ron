// Toybox Twister — the toy store's big hall divided into rooms (art bible §3.2), dressed for a
// party: the same calm warm-white base as Toy Town, plus coloured display spots on the hero props
// (always on) and the light-up arches, archways and rainbow tunnels glowing all day at full
// strength (`practicals`). Shop windows on the east and west walls, warm ceiling spots at night.
// Light units: lux / real-world lumens (rc_render::lamp_lumens), EV100; colours sRGB 0–1.
(
    name: "Toy store",
    indoor: true,
    shadow_distance: 130.0,
    // Party spots from the ceiling (always on) and warm display spots for the night.
    lights: [
        (pos: (-48.0, 19.2, -46.0), target: Some((-64.0, 5.0, -62.0)), angle: 24.0, color: (1.0, 0.3, 0.8), lumens: 14000.0, range: 60.0),
        (pos: (-80.0, 19.2, -44.0), target: Some((-64.0, 5.0, -62.0)), angle: 24.0, color: (0.25, 0.8, 1.0), lumens: 14000.0, range: 60.0),
        (pos: (24.0, 19.2, -48.0), target: Some((24.0, 1.0, -62.0)), angle: 30.0, color: (0.55, 1.0, 0.3), lumens: 12000.0, range: 60.0),
        (pos: (6.0, 19.2, 40.0), target: Some((6.0, 4.0, 26.0)), angle: 28.0, color: (0.65, 0.35, 1.0), lumens: 14000.0, range: 60.0),
        (pos: (-20.0, 19.2, -66.0), target: Some((-10.0, 11.0, -80.0)), angle: 30.0, color: (1.0, 0.45, 0.2), lumens: 12000.0, range: 60.0),
        (pos: (40.0, 19.2, 84.0), target: Some((40.0, 0.3, 72.0)), angle: 26.0, color: (1.0, 0.25, 0.3), lumens: 12000.0, range: 60.0),
        (pos: (92.0, 19.2, -26.0), target: Some((92.0, 1.0, -13.0)), angle: 26.0, color: (0.3, 0.5, 1.0), lumens: 12000.0, range: 60.0),
        (pos: (-24.0, 19.2, 14.0), target: Some((-24.0, 2.5, 6.0)), angle: 24.0, color: (1.0, 0.85, 0.3), lumens: 12000.0, range: 60.0),
        (pos: (-50.0, 19.2, -40.0), target: Some((-64.0, 6.0, -62.0)), angle: 26.0, color: (1.0, 0.86, 0.66), lumens: 16000.0, range: 60.0, times: [Sunset, Night]),
        (pos: (-64.0, 4.0, -62.0), color: (1.0, 0.9, 0.78), lumens: 2500.0, range: 26.0, times: [Night]),
    ],
    room: Some((
        height: 20.0,
        // Clear of the partitions meeting the walls (east z -36 and 6, west z 46).
        windows: [
            (wall: East, center: 0.195, width: 30.0, height: 10.0, sill: 4.0),
            (wall: East, center: 0.4, width: 26.0, height: 10.0, sill: 4.0),
            (wall: East, center: 0.711, width: 30.0, height: 10.0, sill: 4.0),
            (wall: West, center: 0.2, width: 30.0, height: 10.0, sill: 4.0),
            (wall: West, center: 0.5, width: 30.0, height: 10.0, sill: 4.0),
            (wall: West, center: 0.826, width: 20.0, height: 10.0, sill: 4.0),
        ],
        lamps: Some((spacing: 36.0, color: (1.0, 0.85, 0.66), lumens: 20000.0, range: 80.0, spot_angle: Some(56.0), fixture: 14.0)),
    )),
    materials: {
        // Beech floor and shelves (the wood texture is beech-toned).
        "floor": (set: Some("wood_planks"), color: (1.0, 0.97, 0.93), variation: 0.1),
        // Felt play-mat, play-mat teal #2E9C9A.
        "play_mat": (set: Some("carpet"), color: (0.24, 0.78, 0.79), variation: 0.08),
        "wall": (set: Some("plaster"), color: (1.0, 0.97, 0.94)),
        "ceiling": (set: Some("plaster"), color: (1.0, 1.0, 0.98)),
        "trim": (set: Some("wood_planks"), color: (0.95, 0.9, 0.85)),
        // Foam block borders and toy-track walls: glossy orange plastic.
        "barrier": (color: (0.94, 0.48, 0.12), roughness: 0.25, variation: 0.03),
        "ribbon_side": (color: (0.85, 0.42, 0.1), roughness: 0.3, variation: 0.02),
        // Way-finding (GDD §7.3): red toy boards with white chevrons; white arrows on the track.
        "guide_board": (color: (0.85, 0.2, 0.15), roughness: 0.3, variation: 0.0),
        "guide_chevron": (color: (0.95, 0.95, 0.92), roughness: 0.3, variation: 0.0, emissive: (0.12, 0.12, 0.115)),
    },
    surfaces: { Carpet: "play_mat", Wood: "floor" },
