// Prop catalog — toy store (Toy Town). Kinds are prefixed `toy_`. Units: u (1 u = 22.5 cm),
// real size × 4.44; origin = ground-contact centre, front faces −Z. Models go to
// models/props/toy_store/ (art bible §3.2); until they exist rc_render draws the colliders.
// Format: docs/design/rc_track.md §Props.
(
    props: {
        // Wooden play block, 1.4 u (≈ 31 cm) cube: stacked into knockable towers.
        "toy_block_cube": (
            model: "models/props/toy_store/block_cube.glb",
            dynamic: true,
            mass: 0.35,
            colliders: [Box(half: (0.7, 0.7, 0.7), offset: (0, 0.7, 0))],
        ),
        // Display dollhouse the toy track drives through: 12 u wide, 10 u deep, 11 u tall,
        // with an 8 u wide × 3.4 u high tunnel through the ground floor along Z.
        "toy_dollhouse": (
            model: "models/props/toy_store/dollhouse.glb",
            colliders: [
                Box(half: (1, 3.4, 5), offset: (-5, 3.4, 0)),
                Box(half: (1, 3.4, 5), offset: (5, 3.4, 0)),
                Box(half: (6, 3.8, 5), offset: (0, 7.2, 0)),
            ],
        ),
        // Big cardboard toy box (packaging) with a drivable lid, 8 × 2.5 × 8 u.
        "toy_cardboard_box": (
            model: "models/props/toy_store/cardboard_box.glb",
            surface: Cardboard,
            colliders: [Box(half: (4, 1.25, 4), offset: (0, 1.25, 0))],
        ),
        // Plywood plank ramp up onto the toy box: 4 u wide, 2.5 u rise over 9 u (15.5°).
        "toy_plank_ramp": (
            model: "models/props/toy_store/plank_ramp.glb",
            surface: Wood,
            colliders: [Wedge(half: (2, 1.25, 4.5), offset: (0, 1.25, 0))],
        ),
        // Centre column of the toy-track helix (decor + obstacle), radius 4, 12 u tall.
        "toy_helix_tower": (
            model: "models/props/toy_store/helix_tower.glb",
            colliders: [Cylinder(radius: 4, half_height: 6, offset: (0, 6, 0))],
        ),
    },
)
