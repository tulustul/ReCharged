// Prop catalog — common props any track may use (unprefixed kinds). Units: u (1 u = 22.5 cm),
// real size × 4.44; origin = ground-contact centre, front faces −Z. One file per environment
// (`props/<environment>.ron`, kinds prefixed by environment); all files are merged and a kind
// defined twice is a load error. Format: docs/design/rc_track.md §Props.
// rc_track reads colliders/dynamic/mass/surface; rc_render reads `model` (and may add fields).
(
    props: {
        // Knockable test crate, 1.6 u cube.
        "crate_small": (
            model: "models/props/common/crate_small.glb",
            dynamic: true,
            mass: 0.6,
            colliders: [Box(half: (0.8, 0.8, 0.8), offset: (0, 0.8, 0))],
        ),
        // Static stack of tyres.
        "tyre_stack": (
            model: "models/props/common/tyre_stack.glb",
            colliders: [Cylinder(radius: 1.3, half_height: 1.0, offset: (0, 1.0, 0))],
        ),
        // Wooden kicker ramp, 6 u wide, 2 u rise over 12 u (driven up heading −Z).
        "ramp_wedge": (
            model: "models/props/common/ramp_wedge.glb",
            surface: Wood,
            colliders: [Wedge(half: (3, 1, 6), offset: (0, 1, 0))],
        ),
    },
)
