                Wedge(half: (2.4, 4.6, 6.6), offset: (0, 6.9, -3.7)),
            ],
        ),
        // Walnut sideboard / TV unit, 8.9 x 2.0 x 2.44 u (solid to the floor).
        "house_sideboard": (
            model: "models/props/house/sideboard.glb",
            surface: Wood,
            colliders: [Box(half: (4.45, 1.22, 1.0), offset: (0, 1.22, 0))],
