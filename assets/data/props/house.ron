// Prop catalog — family house (Sofa Circuit, art bible §3.3). Kinds are prefixed `house_`.
// Units: u (1 u = 22.5 cm, real size x 4.44); origin = ground-contact centre, front -Z.
// Models: tools/blender/props/house/*.py -> models/props/house/*.glb
// (tools/blender/props/house/build.sh rebuilds them and validates them against this file).
// Colliders stay inside the visual meshes; drivable tops carry a `surface`.
// `lights` (rc_render): offset (prop space, u), linear colour, lumens, range (u), spot_deg
// (0 = point light) — the same format as street.ron.
// Format: docs/design/rc_track.md §Props. Decorative, out-of-reach dressing lives in
// data/decor/sofa_circuit.ron instead.
(
    props: {
        // ---- hero props ------------------------------------------------------------------
        // Sage three-seater on tall oak legs, 10.66 x 4.22 x 4.2 u; 1.75 u clear underneath:
        // the track tunnels under it front to back.
        "house_sofa": (
            model: "models/props/house/sofa.glb",
            surface: Carpet,
            colliders: [
                Box(half: (5.33, 0.4, 2.11), offset: (0, 2.15, 0)),
                Box(half: (5.33, 0.83, 0.55), offset: (0, 3.38, 1.56)),
                Box(half: (0.45, 0.33, 2.11), offset: (4.88, 2.88, 0)),
                Box(half: (0.45, 0.33, 2.11), offset: (-4.88, 2.88, 0)),
                Cylinder(radius: 0.13, half_height: 0.875, offset: (4.95, 0.875, 1.75)),
                Cylinder(radius: 0.13, half_height: 0.875, offset: (-4.95, 0.875, 1.75)),
                Cylinder(radius: 0.13, half_height: 0.875, offset: (4.95, 0.875, -1.75)),
                Cylinder(radius: 0.13, half_height: 0.875, offset: (-4.95, 0.875, -1.75)),
            ],
        ),
        // Square oak coffee table, 5.55 x 1.55 u (35 cm); the bare top is the jump deck between
        // the two book ramps. Solid below the top (legs + shelf would trap a car's nose).
        "house_coffee_table": (
            model: "models/props/house/coffee_table.glb",
            surface: Wood,
            colliders: [
                Box(half: (2.775, 0.09, 2.775), offset: (0, 1.46, 0)),
                Box(half: (2.5, 0.685, 2.5), offset: (0, 0.685, 0)),
            ],
        ),
        // Book-stack ramp: 5.5 u wide, rises 1.55 u over 8.0 u (11 deg) towards -Z; the slanted
        // book covers lie exactly on the wedge.
        "house_book_ramp": (
            model: "models/props/house/book_ramp.glb",
            surface: Cardboard,
            colliders: [Wedge(half: (2.75, 0.775, 4.0), offset: (0, 0.775, 0))],
        ),
        // Oak dining table 11.5 x 4.0 x 3.33 u (2.8 u clear under the apron), laid for two.
        "house_dining_table": (
            model: "models/props/house/dining_table.glb",
            surface: Wood,
            colliders: [
                Box(half: (5.75, 0.09, 2.0), offset: (0, 3.24, 0)),
                Box(half: (5.45, 0.18, 1.7), offset: (0, 2.97, 0)),
                Box(half: (0.155, 1.4, 0.155), offset: (5.35, 1.4, 1.65)),
                Box(half: (0.155, 1.4, 0.155), offset: (-5.35, 1.4, 1.65)),
                Box(half: (0.155, 1.4, 0.155), offset: (5.35, 1.4, -1.65)),
                Box(half: (0.155, 1.4, 0.155), offset: (-5.35, 1.4, -1.65)),
            ],
        ),
        // Hall staircase, 4.8 x 20.6 u, front (-Z) = the way up: two steps to a 5 u landing at
        // 2.3 u (both sides open), then the flight to the ceiling over a closed cupboard.
        "house_staircase": (
            model: "models/props/house/staircase.glb",
            surface: Wood,
            colliders: [
                Box(half: (2.4, 0.383, 0.6), offset: (0, 0.383, 9.7)),
                Box(half: (2.4, 0.767, 0.6), offset: (0, 0.767, 8.5)),
