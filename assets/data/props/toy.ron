// Prop catalog — Toy Town (toy store / playroom, art bible §3.2). Kinds are prefixed `toy_`.
// Units: u (1 u = 22.5 cm), real size × 4.44 (display pieces of a toy store: jumbo blocks, a
// walk-in dollhouse, a play castle); origin = ground-contact centre, front faces −Z. Models:
// models/props/toy/<name>.glb, generated by tools/blender/props/toy/<name>.py (notes:
// docs/design/env-toy.md). Colliders stay inside the visual meshes.
// Format: docs/design/rc_track.md §A9.
(
    props: {
        // --- jumbo wooden blocks (dynamic, knockable; stack them exactly: 1.4 u grid) -------
        // ABC block, 1.4 u cube: recessed painted fields with raised numbers and shapes.
        "toy_block_cube": (
            model: "models/props/toy/block_cube.glb",
            dynamic: true,
            mass: 0.35,
            colliders: [Box(half: (0.7, 0.7, 0.7), offset: (0, 0.7, 0))],
        ),
        // Beech plank, 2.8 × 0.7 × 1.4 u (long along x).
        "toy_block_plank": (
            model: "models/props/toy/block_plank.glb",
            dynamic: true,
            mass: 0.35,
            colliders: [Box(half: (1.4, 0.35, 0.7), offset: (0, 0.35, 0))],
        ),
        // Red pillar, Ø 1.4 × 1.4 u (rounded rims: the collider stays 2 cm inside).
        "toy_block_pillar": (
            model: "models/props/toy/block_pillar.glb",
            dynamic: true,
            mass: 0.27,
            colliders: [Cylinder(radius: 0.68, half_height: 0.7, offset: (0, 0.7, 0))],
        ),
        // Blue 45° roof prism, 1.4 × 0.7 × 1.4 u, ridge along x: two wedges back to back.
        "toy_block_roof": (
            model: "models/props/toy/block_roof.glb",
            dynamic: true,
            mass: 0.12,
            colliders: [
                Wedge(half: (0.7, 0.35, 0.35), offset: (0, 0.35, 0.35)),
                Wedge(half: (0.7, 0.35, 0.35), offset: (0, 0.35, -0.35), rot: (0, 180, 0)),
            ],
        ),
        // Yellow arch, 2.8 × 1.4 × 1.4 u with a round opening (r 0.65) along z.
        "toy_block_arch": (
            model: "models/props/toy/block_arch.glb",
            dynamic: true,
            mass: 0.55,
            colliders: [
                Box(half: (0.375, 0.7, 0.7), offset: (-1.025, 0.7, 0)),
                Box(half: (0.375, 0.7, 0.7), offset: (1.025, 0.7, 0)),
                Box(half: (0.65, 0.325, 0.7), offset: (0, 1.075, 0)),
            ],
        ),

        // --- toy-track kit ------------------------------------------------------------------
        // Support pillar (placements generated by tools/blender/props/toy/supports.py). The
        // origin is the bracket top under the ribbon's edge; the column runs 8 u down into the
        // floor, so one model fits every height.
        "toy_track_support": (
            model: "models/props/toy/track_support.glb",
            colliders: [Box(half: (0.4, 4.29, 0.4), offset: (0, -3.725, 0))],
        ),
        // Moulded jump ramp, 4 u wide, rising 2.5 u over 9 u (15.5°) toward its front.
        "toy_track_ramp": (
            model: "models/props/toy/track_ramp.glb",
            surface: ToyTrack,
            colliders: [Wedge(half: (2, 1.25, 4.5), offset: (0, 1.25, 0))],
        ),

        // --- hero pieces ---------------------------------------------------------------------
        // Walk-in display dollhouse the track drives through: 14 × 10 u plan (x across the
        // tunnel), a 9 u wide, 4 u high tunnel along z; a porch on each long side.
        "toy_dollhouse": (
            model: "models/props/toy/dollhouse.glb",
            colliders: [
                Box(half: (1.25, 3.7, 5), offset: (-5.75, 3.7, 0)),
                Box(half: (1.25, 3.7, 5), offset: (5.75, 3.7, 0)),
                Box(half: (4.5, 1.7, 5), offset: (0, 5.7, 0)),
                Box(half: (3.4, 1.4, 5), offset: (0, 8.8, 0)),
                Box(half: (1.0, 0.12, 1.8), offset: (8.0, 0.12, 0)),
                Box(half: (1.0, 0.12, 1.8), offset: (-8.0, 0.12, 0)),
            ],
        ),
        // Play castle inside the helix: 10 u square walls, four towers (r 1.7) at the corners,
        // a keep and a gatehouse at the front; within r 8.8 of its origin.
        "toy_castle": (
            model: "models/props/toy/castle.glb",
            colliders: [
                Box(half: (5, 2.3, 5), offset: (0, 2.3, 0)),
                Cylinder(radius: 1.7, half_height: 3.5, offset: (-5, 3.5, -5)),
                Cylinder(radius: 1.7, half_height: 3.5, offset: (5, 3.5, -5)),
                Cylinder(radius: 1.7, half_height: 3.5, offset: (-5, 3.5, 5)),
                Cylinder(radius: 1.7, half_height: 3.5, offset: (5, 3.5, 5)),
                Box(half: (2, 5, 2), offset: (0, 5, 0.8)),
                Box(half: (2.1, 3.1, 0.75), offset: (0, 3.1, -4.4)),
            ],
        ),
        // Kids' play table with a printed little town on top (Golden Battery perch): 6 × 9 u,
        // drivable top at 2.5 u, 1.8 u clearance underneath.
        "toy_play_table": (
            model: "models/props/toy/play_table.glb",
            surface: Wood,
            colliders: [
                Box(half: (3, 0.35, 4.5), offset: (0, 2.15, 0)),
                Box(half: (0.25, 1.1, 0.25), offset: (-2.45, 1.1, -3.95)),
                Box(half: (0.25, 1.1, 0.25), offset: (2.45, 1.1, -3.95)),
                Box(half: (0.25, 1.1, 0.25), offset: (-2.45, 1.1, 3.95)),
                Box(half: (0.25, 1.1, 0.25), offset: (2.45, 1.1, 3.95)),
            ],
        ),
        // Start/finish gate of the toy track: striped posts 13.6 u apart (outside the barriers)
        // carrying a checkered banner 5.4–6.9 u up; spans x (place it across the start line).
        "toy_start_arch": (
            model: "models/props/toy/start_arch.glb",
            colliders: [
                Cylinder(radius: 0.38, half_height: 3.6, offset: (-6.8, 3.6, 0)),
                Cylinder(radius: 0.38, half_height: 3.6, offset: (6.8, 3.6, 0)),
            ],
        ),
        // Giant plush teddy bear (1.5 m), sitting, legs toward the front; ~5.3 u tall.
        "toy_bear": (
            model: "models/props/toy/bear.glb",
            colliders: [
                Ball(radius: 1.1, offset: (0, 1.75, 0)),
                Ball(radius: 1.0, offset: (0, 3.95, -0.1)),
                Box(half: (0.35, 0.38, 0.65), offset: (-0.78, 0.58, -0.95)),
                Box(half: (0.35, 0.38, 0.65), offset: (0.78, 0.58, -0.95)),
            ],
        ),
        // Inflatable ball pit (Ø 6 u rings, 1.4 u high) heaped with balls; a few spilled ones
        // around it are visual only.
        "toy_ball_pit": (
            model: "models/props/toy/ball_pit.glb",
            colliders: [Cylinder(radius: 2.9, half_height: 0.68, offset: (0, 0.68, 0))],
        ),
        // Rocking horse (1 m long, real size) on bow rockers, facing −Z.
        "toy_rocking_horse": (
            model: "models/props/toy/rocking_horse.glb",
            colliders: [
                Box(half: (0.07, 0.11, 1.2), offset: (-0.56, 0.12, 0)),
                Box(half: (0.07, 0.11, 1.2), offset: (0.56, 0.12, 0)),
                Box(half: (0.25, 0.25, 0.7), offset: (0, 1.75, 0)),
            ],
        ),
        // Toy packaging (67 × 27 × 50 cm) with a toy car in its window; stacks on the floor.
        "toy_box": (
            model: "models/props/toy/toy_box.glb",
            colliders: [Box(half: (1.5, 1.1, 0.6), offset: (0, 1.1, 0))],
        ),
        // Retro tin robot (67 cm) waving a checkered flag (the starter), facing −Z.
        "toy_robot": (
            model: "models/props/toy/robot.glb",
            colliders: [
                Box(half: (0.65, 1.15, 0.42), offset: (0, 1.15, 0)),
                Box(half: (0.45, 0.35, 0.38), offset: (0, 2.85, 0)),
            ],
        ),
        // Wooden pull-along train (engine + two wagons, 1 m), along z, engine at the front.
        "toy_train": (
            model: "models/props/toy/train.glb",
            colliders: [Box(half: (0.4, 0.42, 2.15), offset: (0, 0.45, -0.05))],
        ),
        // Stacking-rings toy (30 cm).
        "toy_stacking_rings": (
            model: "models/props/toy/stacking_rings.glb",
            colliders: [Cylinder(radius: 0.5, half_height: 0.62, offset: (0, 0.62, 0))],
        ),
        // Big rubber duck (22 cm), facing −Z.
        "toy_duck": (
            model: "models/props/toy/duck.glb",
            colliders: [
                Ball(radius: 0.34, offset: (0, 0.38, 0)),
                Ball(radius: 0.3, offset: (0, 0.93, -0.33)),
            ],
        ),
        // Open crayon pack with loose crayons fanned out in front (only the pack collides).
        "toy_crayons": (
            model: "models/props/toy/crayons.glb",
            colliders: [Box(half: (0.3, 0.27, 0.11), offset: (0, 0.28, 0))],
        ),
        // Interlocking foam play tiles: a loose stack of four + two laid out (the stack collides).
        "toy_foam_tiles": (
            model: "models/props/toy/foam_tiles.glb",
            colliders: [Box(half: (1.2, 0.1, 1.2), offset: (0, 0.1, 0))],
        ),
        // Static heap of tumbled jumbo blocks (decor clutter, no dynamic bodies).
        "toy_block_pile": (
            model: "models/props/toy/block_pile.glb",
            colliders: [
                Box(half: (0.6, 0.7, 0.6), offset: (0, 0.7, 0)),
                Box(half: (0.6, 0.7, 0.6), offset: (1.45, 0.7, -0.35)),
                Box(half: (1.2, 0.33, 0.6), offset: (0.4, 0.35, 1.5)),
                Ball(radius: 0.6, offset: (-1.6, 0.7, 1.3)),
                Ball(radius: 0.65, offset: (-1.35, 0.89, -1.1)),
                Ball(radius: 0.65, offset: (0.6, 2.1, -0.15)),
            ],
        ),
        // Low playroom cubby shelf (fits under the shop windows), 4.7 × 3.3 × 1.6 u, front −Z.
        "toy_cubby": (
            model: "models/props/toy/cubby.glb",
            colliders: [Box(half: (2.35, 1.6, 0.8), offset: (0, 1.6, 0))],
        ),
        // Toy-store gondola shelves stocked with toys (backdrop along the walls), 5.4 × 8 ×
        // 2.2 u (+ header sign to 9.3 u); two stock arrangements.
        "toy_shelf_a": (
            model: "models/props/toy/shelf_a.glb",
            colliders: [Box(half: (2.7, 3.95, 1.05), offset: (0, 3.95, 0))],
        ),
        "toy_shelf_b": (
            model: "models/props/toy/shelf_b.glb",
            colliders: [Box(half: (2.7, 3.95, 1.05), offset: (0, 3.95, 0))],
        ),
    },
)
