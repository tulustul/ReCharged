// Wrench Works — auto-repair workshop (art bible §3.6): gritty but readable; warm sodium work
// lights (always on) against cool daylight from two roller doors on the north wall and one behind
// the wash bay; light painted-block walls; oil stains. Layout bounds x −88..88, z −60..60.
(
    name: "Workshop",
    indoor: true,
    shadow_distance: 120.0,
    room: Some((
        height: 24.0,
        windows: [
            // Roller doors (open): no mullions, no rain on the "glass".
            (wall: North, center: 0.534, width: 18.0, height: 18.0, sill: 0.0, door: true),
            (wall: North, center: 0.682, width: 18.0, height: 18.0, sill: 0.0, door: true),
            (wall: South, center: 0.653, width: 16.0, height: 16.0, sill: 0.0, door: true),
            // High window on the east wall.
            (wall: East, center: 0.5, width: 24.0, height: 7.0, sill: 10.0),
        ],
        lamps: Some((spacing: 36.0, color: (1.0, 0.78, 0.54), lumens: 70000.0, range: 95.0, spot_angle: Some(72.0), fixture: 16.0)),
    )),
    materials: {
        // Stained concrete #8D8A84.
        "floor": (set: Some("concrete"), color: (0.98, 0.97, 0.95), variation: 0.22),
        // Ribbed rubber mats #2A2A2A.
        "rubber_mat": (set: Some("rubber"), color: (1.0, 1.0, 1.0)),
        // Plywood ramps #C8A46E.
        "plywood": (set: Some("plywood"), color: (0.97, 0.95, 0.9)),
        // Light painted block walls, grey-cream.
        "wall": (set: Some("concrete"), color: (0.85, 0.84, 0.8), roughness: 0.95, variation: 0.08),
        "ceiling": (set: Some("metal"), color: (0.72, 0.72, 0.7), roughness: 1.6),
        // Hazard-yellow kerbs #F2B705 and black rubber tyre-wall blocks.
        "trim": (color: (0.95, 0.72, 0.02), roughness: 0.6, variation: 0.08),
        "barrier": (set: Some("rubber"), color: (0.9, 0.9, 0.9)),
        "ribbon_side": (set: Some("metal"), color: (0.35, 0.36, 0.38)),
    },
    surfaces: { Asphalt: "floor", Carpet: "rubber_mat", Wood: "plywood" },
    morning: (
        // Low warm sun through the high east window: a light shaft on the floor.
        sun: (elevation: 18.0, azimuth: 95.0, lux: 4200.0, color: (1.0, 0.84, 0.62)),
        fill: Some((elevation: 75.0, azimuth: 0.0, lux: 550.0, color: (0.82, 0.88, 1.0), shadows: false)),
        exposure: 8.6,
