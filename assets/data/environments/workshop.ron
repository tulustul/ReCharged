        fog_color: (0.62, 0.58, 0.52),
        fog_visibility: 900.0,
        grading: (temperature: 0.0, saturation: 1.0, contrast: 1.06),
        bloom: 0.12,
        lamps: 1.0,
        window: (1.4, 1.55, 1.8),
    ),
    noon: (
