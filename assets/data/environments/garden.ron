// Backyard Bash — back garden (art bible §3.4): sunny suburban garden, saturated greens, warm
// terracotta, long sunset shadows; porch and fairy lights at night (prop lights).
(
    name: "Garden",
    indoor: false,
    sky: (ground_albedo: (0.18, 0.3, 0.14), stars: 40.0),
    shadow_distance: 130.0,
    materials: {
        // Lawn #5E9A3A.
        "floor": (set: Some("grass"), color: (1.0, 1.0, 1.0), variation: 0.18),
        // Decking #8A6142.
        "deck": (set: Some("wood_planks"), color: (0.76, 0.72, 0.7), roughness: 1.6),
        // Brick edging and low fence boards.
        "barrier": (set: Some("concrete"), color: (0.78, 0.45, 0.34), roughness: 1.0),
        "trim": (set: Some("concrete"), color: (0.75, 0.42, 0.3)),
        "wall": (set: Some("plywood"), color: (0.62, 0.52, 0.42), roughness: 1.2),
        "ribbon_side": (set: Some("dirt"), color: (0.9, 0.9, 0.9)),
    },
    surfaces: { Wood: "deck" },
    morning: (
        sun: (elevation: 14.0, azimuth: 95.0, lux: 128000.0),
        env_light: 7000.0,
        exposure: 13.1,
        fog_color: (0.72, 0.72, 0.7),
        fog_visibility: 2400.0,
        grading: (temperature: 0.03, saturation: 1.08, contrast: 1.04),
        bloom: 0.1,
        clouds: (lit: (1.0, 0.86, 0.72), shade: (0.42, 0.45, 0.56)),
    ),
    noon: (
        sun: (elevation: 60.0, azimuth: 170.0, lux: 128000.0),
        env_light: 9000.0,
        exposure: 14.8,
        fog_color: (0.68, 0.75, 0.84),
        fog_visibility: 2400.0,
        grading: (saturation: 1.1, contrast: 1.05),
        bloom: 0.1,
        clouds: (lit: (1.0, 0.99, 0.97), shade: (0.55, 0.6, 0.68)),
    ),
    sunset: (
        sun: (elevation: 7.0, azimuth: 265.0, lux: 128000.0),
        env_light: 7000.0,
        exposure: 11.3,
        fog_color: (0.78, 0.6, 0.48),
        fog_visibility: 2000.0,
        grading: (temperature: 0.06, saturation: 1.12, contrast: 1.06),
        bloom: 0.14,
        clouds: (lit: (1.0, 0.6, 0.38), shade: (0.32, 0.27, 0.38)),
    ),
    night: (
        sun: (elevation: 38.0, azimuth: 200.0, lux: 18.0, color: (0.72, 0.82, 1.0)),
        env_light: 40.0,
        exposure: 2.6,
        ambient: 1.5,
        ambient_color: (0.5, 0.6, 0.85),
        fog_color: (0.02, 0.03, 0.05),
        fog_visibility: 1600.0,
        grading: (temperature: -0.04, saturation: 0.9, contrast: 1.08),
        bloom: 0.18,
        clouds: (lit: (0.06, 0.075, 0.11), shade: (0.015, 0.02, 0.03)),
    ),
)
