// Aisle Rush — supermarket after closing (art bible §3.5; Sunset and Night only): cold fluorescent
// light with half the tubes off, glowing freezer cases, deep shadows between aisles; sunset light
// through the shopfront on the south wall.
(
    name: "Supermarket",
    indoor: true,
    shadow_distance: 120.0,
    room: Some((
        height: 22.0,
        windows: [
            (wall: South, center: 0.2, width: 34.0, height: 15.0, sill: 1.0),
            (wall: South, center: 0.5, width: 34.0, height: 15.0, sill: 1.0),
            (wall: South, center: 0.8, width: 34.0, height: 15.0, sill: 1.0),
        ],
        // The decor's ceiling tube rows are the visible fixtures (fixture 0).
        lamps: Some((spacing: 38.0, color: (0.9, 0.96, 1.0), lumens: 12000.0, range: 80.0, spot_angle: Some(75.0), fixture: 0.0)),
    )),
    // Decor ceiling tubes follow the store lamps (lit by day, 15 % at night).
    fixture_materials: ["tube_on"],
    materials: {
        // Polished vinyl tile, off-white #D9D6CC.
        "floor": (set: Some("vinyl"), color: (1.0, 1.0, 1.0), variation: 0.06),
        "wall": (set: Some("plaster"), color: (0.82, 0.84, 0.86)),
        "ceiling": (set: Some("plaster"), color: (0.9, 0.9, 0.9)),
        // Rubber skirting; painted-steel shelf kick plates #8E959C (the barrier blocks).
        "trim": (set: Some("rubber"), color: (0.8, 0.8, 0.8)),
        "barrier": (color: (0.557, 0.584, 0.612), roughness: 0.45, variation: 0.04),
        "ribbon_side": (set: Some("metal"), color: (0.5, 0.52, 0.55)),
    },
    surfaces: { Tile: "floor" },
    morning: (
        sun: (elevation: 20.0, azimuth: 150.0, lux: 5000.0, color: (1.0, 0.95, 0.88)),
        fill: Some((elevation: 80.0, azimuth: 180.0, lux: 500.0, color: (0.92, 0.96, 1.0), shadows: false)),
        exposure: 9.4,
        env_light: 110.0,
        room: (floor: (0.6, 0.6, 0.57), walls: (0.55, 0.57, 0.6), ceiling: (0.6, 0.62, 0.65), window: (5.0, 5.0, 5.0), lamp: (4.0, 4.3, 4.6)),
        fog_color: (0.75, 0.78, 0.8),
        fog_visibility: 1400.0,
        grading: (temperature: -0.02, saturation: 1.02, contrast: 1.04),
        bloom: 0.1,
        lamps: 1.0,
        window: (1.6, 1.6, 1.6),
    ),
    noon: (
        sun: (elevation: 55.0, azimuth: 180.0, lux: 5500.0, color: (1.0, 0.98, 0.95)),
        fill: Some((elevation: 80.0, azimuth: 180.0, lux: 600.0, color: (0.92, 0.96, 1.0), shadows: false)),
        exposure: 9.6,
        env_light: 120.0,
        room: (floor: (0.6, 0.6, 0.57), walls: (0.55, 0.57, 0.6), ceiling: (0.6, 0.62, 0.65), window: (5.5, 5.5, 5.6), lamp: (4.0, 4.3, 4.6)),
        fog_color: (0.75, 0.78, 0.8),
        fog_visibility: 1400.0,
        grading: (temperature: -0.02, saturation: 1.02, contrast: 1.04),
        bloom: 0.1,
        lamps: 1.0,
        window: (1.8, 1.8, 1.85),
    ),
    sunset: (
