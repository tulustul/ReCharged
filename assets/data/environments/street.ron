// Maple Street — suburban street and front lawns (art bible §3.7): wide open autumn morning,
// maple reds and oranges, clean asphalt; sodium street lamps and porch lights at night (props).
(
    name: "Street",
    indoor: false,
    sky: (ground_albedo: (0.22, 0.24, 0.2), stars: 30.0),
    shadow_distance: 150.0,
    materials: {
        // Lawns #5C8F3C, a touch drier in autumn.
        "floor": (set: Some("grass"), color: (0.98, 0.96, 0.88), variation: 0.22, hue_variation: 0.4),
        // Concrete sidewalk #B7B2A8 and kerb stone.
        "sidewalk": (set: Some("concrete"), color: (1.0, 1.0, 0.98), variation: 0.12),
        "trim": (set: Some("concrete"), color: (0.92, 0.91, 0.88)),
        // The corner lot's low garden wall (barrier blocks): two sandstone tones.
        "garden_wall": (set: Some("stone"), color: (0.9, 0.82, 0.7), tile_u: 3.0, variation: 0.2),
        "garden_wall_b": (set: Some("stone"), color: (0.8, 0.72, 0.62), tile_u: 3.0, variation: 0.2),
        "wall": (set: Some("plaster"), color: (0.85, 0.82, 0.76)),
        "ribbon_side": (set: Some("concrete"), color: (0.6, 0.6, 0.6)),
    },
    surfaces: { Stone: "sidewalk" },
    // Low warm ESE sun down Maple Street, long shadows, cool sky fill, a light haze.
    morning: (
        sun: (elevation: 15.0, azimuth: 112.0, lux: 128000.0),
        env_light: 21000.0,
        exposure: 12.8,
        fog_color: (0.8, 0.76, 0.72),
        fog_visibility: 1100.0,
        grading: (temperature: 0.05, saturation: 1.08, contrast: 1.04),
        bloom: 0.1,
        clouds: (lit: (1.0, 0.88, 0.75), shade: (0.45, 0.47, 0.58)),
    ),
    // High neutral sun; sky fill ≈ 3.5× physical so canopy and car shade stay readable
    // (shade ≈ 0.3 of the sunlit ground).
    noon: (
        sun: (elevation: 62.0, azimuth: 165.0, lux: 128000.0),
        env_light: 32000.0,
        exposure: 14.4,
        fog_color: (0.7, 0.76, 0.84),
        fog_visibility: 2600.0,
        grading: (saturation: 1.05, contrast: 1.03),
        bloom: 0.1,
        clouds: (lit: (1.0, 0.99, 0.97), shade: (0.55, 0.6, 0.68)),
    ),
    // Sun low in the west down the street (backlit maples, orange rims), porch lights at 20 %.
    sunset: (
        sun: (elevation: 8.0, azimuth: 268.0, lux: 128000.0),
        env_light: 15000.0,
        exposure: 11.2,
        fog_color: (0.78, 0.62, 0.52),
        fog_visibility: 2600.0,
        grading: (temperature: 0.05, tint: -0.03, saturation: 1.05, contrast: 1.06),
        practicals: Some(0.2),
        bloom: 0.14,
        clouds: (lit: (1.0, 0.6, 0.4), shade: (0.33, 0.28, 0.4)),
    ),
    night: (
        // Cool moonlight fill; the sodium street lamps (props) carry the road.
        sun: (elevation: 42.0, azimuth: 220.0, lux: 22.0, color: (0.66, 0.76, 1.0)),
        env_light: 50.0,
        exposure: 2.6,
        ambient: 1.2,
        ambient_color: (0.5, 0.6, 0.85),
        fog_color: (0.03, 0.03, 0.05),
        fog_visibility: 1600.0,
        grading: (temperature: -0.03, saturation: 0.92, contrast: 1.08),
        bloom: 0.2,
        clouds: (lit: (0.06, 0.075, 0.11), shade: (0.015, 0.02, 0.03)),
    ),
)
