        (kind: "toy_block_cube", pos: (6, 0.3, 29.8)),
        (kind: "toy_block_cube", pos: (7.4, 0.3, 29.8), yaw: 90),
        (kind: "toy_block_cube", pos: (8.8, 0.3, 29.8), yaw: 180),
