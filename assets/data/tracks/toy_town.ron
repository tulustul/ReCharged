        (kind: "toy_block_cube", pos: (-12, 7.7, -38.4), yaw: 90),
        // Towers on both sides of the dollhouse's open north exit.
        (kind: "toy_block_cube", pos: (-50.3, 0.05, -4.2)),
        (kind: "toy_block_cube", pos: (-50.3, 0.05, -2.8), yaw: 180),
